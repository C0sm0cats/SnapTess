<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
<schema id="org.gnome.shell.extensions.snaptess" path="/org/gnome/shell/extensions/snaptess/">
<key name="gap" type="i"><default>12</default><summary>Space between windows</summary>
<range min="0" max="64"/>
</key>
<key name="padding" type="i"><default>12</default><summary>Space at screen edges</summary>
<range min="0" max="64"/>
</key>
<key name="master-ratio" type="d"><default>0.6</default><summary>Width of the focus column</summary>
<range min="0.25" max="0.75"/>
</key>
<key name="animations" type="b"><default>true</default><summary>Animate placement guides</summary>
</key>
<key name="active-border" type="b"><default>true</default><summary>Highlight the focused tiled window</summary>
</key>
<key name="compact-minimize" type="b"><default>true</default><summary>Compact when a window is minimized</summary>
</key>
<key name="compact-close" type="b"><default>true</default><summary>Compact when a window closes</summary>
</key>
<key name="profiles" type="s"><default>'{}'</default><summary>Per-space layouts and application ordering</summary>
</key>
<key name="preview-state" type="s"><default>'{}'</default><summary>Current tiling preview state shared with preferences</summary>
</key>
<key name="saved-layouts" type="s"><default>'[]'</default><summary>Named layouts restored on demand</summary>
</key>
<key name="excluded-apps" type="as"><default>[]</default><summary>Application IDs excluded from tiling</summary>
</key>
<key name="scaled-apps" type="as"><default>['discord.desktop', 'onlyoffice-desktopeditors.desktop', 'cherrytree.desktop', 'brave-browser.desktop', 'org.gnome.Calculator.desktop', 'chatgpt.desktop', 'stably-orca.desktop', 'com.github.jeromerobert.pdfarranger.desktop', 'pdf4teachers.desktop', 'code-oss.desktop', 'com.mattjakeman.ExtensionManager.desktop', 'hermes.desktop']</default><summary>Application IDs allowed to use compositor scaling</summary>
</key>
<key name="toggle" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;t']</default><summary>Toggle</summary>
</key>
<key name="retile" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;r']</default><summary>Retile</summary>
</key>
<key name="studio" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;p']</default><summary>Studio</summary>
</key>
<key name="layout-switcher" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;l']</default><summary>Change layout</summary>
</key>
<key name="floating" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;f']</default><summary>Floating</summary>
</key>
<key name="swap" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;s']</default><summary>Swap</summary>
</key>
<key name="focus-left" type="as"><default>['&lt;Control&gt;&lt;Super&gt;Left']</default><summary>Focus the tiled window to the left</summary>
</key>
<key name="focus-right" type="as"><default>['&lt;Control&gt;&lt;Super&gt;Right']</default><summary>Focus the tiled window to the right</summary>
</key>
<key name="focus-up" type="as"><default>['&lt;Control&gt;&lt;Super&gt;Up']</default><summary>Focus the tiled window above</summary>
</key>
<key name="focus-down" type="as"><default>['&lt;Control&gt;&lt;Super&gt;Down']</default><summary>Focus the tiled window below</summary>
</key>
<key name="undo" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;z']</default><summary>Undo</summary>
</key>
<key name="space-1" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;1']</default><summary>Space 1</summary>
</key>
<key name="space-2" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;2']</default><summary>Space 2</summary>
</key>
<key name="space-3" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;3']</default><summary>Space 3</summary>
</key>
<key name="redo" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;y']</default><summary>Redo</summary>
</key>
<key name="stop" type="as"><default>['&lt;Control&gt;&lt;Alt&gt;q']</default><summary>Stop</summary>
</key>
<key name="independent-padding" type="b"><default>false</default><summary>Use independent screen edge spacing</summary></key>
<key name="padding-top" type="i"><default>12</default><summary>Top screen edge spacing</summary><range min="0" max="64"/></key>
<key name="padding-right" type="i"><default>12</default><summary>Right screen edge spacing</summary><range min="0" max="64"/></key>
<key name="padding-bottom" type="i"><default>12</default><summary>Bottom screen edge spacing</summary><range min="0" max="64"/></key>
<key name="padding-left" type="i"><default>12</default><summary>Left screen edge spacing</summary><range min="0" max="64"/></key>
<key name="border-custom-color" type="b"><default>false</default><summary>Use a custom focus color</summary></key>
<key name="border-color" type="s"><default>'#3584e4'</default><summary>Custom focus outline color</summary></key>
<key name="border-width" type="i"><default>2</default><summary>Focus outline thickness</summary><range min="1" max="6"/></key>
<key name="border-style" type="s"><default>'outline'</default><summary>Focus outline style</summary><choices><choice value='outline'/><choice value='halo'/></choices></key>
<key name="animation-speed" type="s"><default>'normal'</default><summary>Visual animation speed</summary><choices><choice value='fast'/><choice value='normal'/><choice value='slow'/><choice value='custom'/></choices></key>
<key name="animation-duration" type="i"><default>140</default><summary>Custom base animation duration in milliseconds</summary><range min="40" max="500"/></key>
<key name="animation-curve" type="s"><default>'ease-out'</default><summary>Visual animation easing</summary><choices><choice value='ease-out'/><choice value='linear'/><choice value='ease-in-out'/><choice value='spring'/></choices></key>
</schema>
</schemalist>
